# Copy this file to `.env` in the project root — docker-compose.yml reads it
# on `docker compose up` (interpolation). Required; compose refuses to start
# without POSTGRES_PASSWORD and will tell you so.

# Required — pick a strong value (e.g. `openssl rand -hex 16`)
POSTGRES_PASSWORD=

# Optional overrides (defaults shown)
# POSTGRES_USER=admin
# POSTGRES_DB=financeapp
# POSTGRES_PORT=5441
# APP_PORT=8000

# NOTE: application secrets (SECRET_KEY, DATABASE_URL for local dev, ...)
# live in backend/.env — see backend/.env.example. Never commit either file.
